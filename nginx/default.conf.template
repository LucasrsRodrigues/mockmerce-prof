server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # DNS interno do Docker/EasyPanel: resolve o backend em RUNTIME. Assim o
    # nginx não quebra no boot caso o backend ainda não tenha subido, e
    # acompanha a troca de IP quando o serviço reinicia.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Proxy da API: /api/* -> BACKEND_URL/* (remove o prefixo /api, igual ao
    # rewrite do proxy do Vite em desenvolvimento).
    location /api/ {
        set $upstream "${BACKEND_URL}";
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # SPA: rotas do React Router caem no index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
